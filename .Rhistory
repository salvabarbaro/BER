library(haven)
library(dplyr)
library(MASS)         # polr()
library(brant)        # brant test for proportional odds
library(brant)        # brant test for proportional odds
install.packages("brant")
library(brant)        # brant test for proportional odds
library(broom)        # tidy() for coefficients
library(lmtest)       # coeftest()
library(sandwich)     # vcovCL()
library(readr)        # write_csv()
# 1) Load data (Stata .dta)
df <- haven::read_dta("~/Documents/Research/Yardstick/BER/ReplicationFiles/RepFiles18Aug25/Main_data_set_replication.dta")
# 2) Restrict to waves 2 or 3 (Stata: if (wave == 2 | wave == 3))
dat <- df %>% filter(wave %in% c(2, 3))
# If `index` is numeric with ordered categories, make it ordered factor
# (polr expects an ordered response)
if (!is.ordered(dat$index)) {
dat <- dat %>% mutate(index = ordered(index))
}
# If `date` is a Date, polr can use it as numeric; create a numeric version for stability
dat <- dat %>% mutate(date_num = if (inherits(date, "Date")) as.numeric(date) else as.numeric(date))
# Helper: cluster-robust tidy with ORs
tidy_cr_or <- function(model) {
# Cluster vector must match the estimation sample
mf <- model.frame(model)
clust <- mf$date_num
Vcl <- sandwich::vcovCL(model, cluster = clust)
ct  <- lmtest::coeftest(model, vcov. = Vcl)
td  <- broom::tidy(ct) %>%
rename(estimate = estimate, std.error = std.error, statistic = statistic, p.value = `Pr(>|z|)`) %>%
# Convert to ORs for slopes; keep intercepts/thresholds un-exponentiated if you prefer
mutate(
term_type = ifelse(grepl("\\|", term), "cutpoint", "slope"),
OR        = ifelse(term_type == "slope", exp(estimate), NA_real_)
)
td
}
# 3) Proportional odds assumption test (full specification like the ologit with all RHS)
# Stata "omodel logit index lninc lnincfed lnvac lnvacfed prevac att_t_fed FKM21 econ_strength east berlin date"
# We'll run polr with those covariates:
m_full <- MASS::polr(
index ~ lninc + lnincfed + lnvac + lnvacfed + prevac + att_t_fed + FKM21 +
econ_strength + east + berlin + date_num,
data = dat,
Hess = TRUE,
method = "logistic",
na.action = na.omit
)
# Brant test (PO/parallel lines)
po_test <- brant::brant(m_full)
print(po_test)
m1 <- polr(index ~ lninc + lnincfed, data = dat, Hess = TRUE, method = "logistic", na.action = na.omit)
m2 <- polr(index ~ lninc + lnincfed + date_num, data = dat, Hess = TRUE, method = "logistic", na.action = na.omit)
m3 <- polr(index ~ lninc + lnincfed + east + berlin + date_num, data = dat, Hess = TRUE, method = "logistic", na.action = na.omit)
m4 <- polr(index ~ lninc + lnincfed + att_t_fed + FKM21 + econ_strength + east + berlin + date_num,
data = dat, Hess = TRUE, method = "logistic", na.action = na.omit)
m5 <- polr(index ~ lninc + lnincfed + lnvac + lnvacfed + prevac + att_t_fed + FKM21 + econ_strength +
east + berlin + date_num,
data = dat, Hess = TRUE, method = "logistic", na.action = na.omit)
# 5) Cluster-robust, odds-ratio summaries for each model
tidy_list <- list(
model1 = tidy_cr_or(m1),
model2 = tidy_cr_or(m2),
model3 = tidy_cr_or(m3),
model4 = tidy_cr_or(m4),
model5 = tidy_cr_or(m5)
)
# Save per-model CSV (similar to Stata exporting estimates)
# maincoefs.csv could hold only slopes; allcoefs.csv could include cutpoints too.
maincoefs <- bind_rows(
lapply(names(tidy_list), function(nm) {
tidy_list[[nm]] %>%
filter(term_type == "slope") %>%
mutate(model = nm) %>%
select(model, term, estimate, std.error, statistic, p.value, OR)
})
)
# 5) Cluster-robust, odds-ratio summaries for each model
tidy_list <- list(
model1 = tidy_cr_or(m1),
model2 = tidy_cr_or(m2),
model3 = tidy_cr_or(m3),
model4 = tidy_cr_or(m4),
model5 = tidy_cr_or(m5)
)
summary(m5)
modelsummary(m5, exponentiate = T, statistic = "conf.int")
modelsummary(m5, exponentiate = T,
statistic = "conf.int",
coef_omit = "2|3|econ")
broom::tidy(m5)
# Helper: cluster-robust tidy with ORs
tidy_cr_or <- function(model) {
# Cluster vector must match the estimation sample
mf <- model.frame(model)
clust <- mf$date_num
Vcl <- sandwich::vcovCL(model, cluster = clust)
ct  <- lmtest::coeftest(model, vcov. = Vcl)
td  <- broom::tidy(ct) %>%
# Convert to ORs for slopes; keep intercepts/thresholds un-exponentiated if you prefer
mutate(
term_type = ifelse(grepl("\\|", term), "cutpoint", "slope"),
OR        = ifelse(term_type == "slope", exp(estimate), NA_real_)
)
td
}
# 3) Proportional odds assumption test (full specification like the ologit with all RHS)
# Stata "omodel logit index lninc lnincfed lnvac lnvacfed prevac att_t_fed FKM21 econ_strength east berlin date"
# We'll run polr with those covariates:
m_full <- MASS::polr(
index ~ lninc + lnincfed + lnvac + lnvacfed + prevac + att_t_fed + FKM21 +
econ_strength + east + berlin + date_num,
data = dat,
Hess = TRUE,
method = "logistic",
na.action = na.omit
)
# Brant test (PO/parallel lines)
po_test <- brant::brant(m_full)
print(po_test)
# 5) Cluster-robust, odds-ratio summaries for each model
tidy_list <- list(
model1 = tidy_cr_or(m1),
model2 = tidy_cr_or(m2),
model3 = tidy_cr_or(m3),
model4 = tidy_cr_or(m4),
model5 = tidy_cr_or(m5)
)
# Save per-model CSV (similar to Stata exporting estimates)
# maincoefs.csv could hold only slopes; allcoefs.csv could include cutpoints too.
maincoefs <- bind_rows(
lapply(names(tidy_list), function(nm) {
tidy_list[[nm]] %>%
filter(term_type == "slope") %>%
mutate(model = nm) %>%
select(model, term, estimate, std.error, statistic, p.value, OR)
})
)
View(tidy_list)
rm(list = ls())
