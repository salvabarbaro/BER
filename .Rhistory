broom::tidy(res.main, exponentiate = T)
modelsummary(res.main, exponentiate = T,
coef_omit = "2|3|econ",
statistic = "conf.int")
## 1) Combine & name models
mods <- c(
setNames(res.main, paste0("Main ", seq_along(res.main))),
setNames(res.ai,   paste0("AI ",   seq_along(res.ai)))
)
## 2) Get tidy estimates for selected terms (as ORs) without drawing
df <- modelplot(
mods,
exponentiate = TRUE,
coef_map = c("lninc"    = "lninc",
"lnincfed" = "lnincfed"),
conf_level = 0.95,
draw = FALSE
) %>%
mutate(
group = ifelse(grepl("^AI ", model), "AI", "Main"),
model_num = sub("^(Main|AI)\\s+", "", model)
)
## 3) Plot: two groups side-by-side per model & term
ggplot(df, aes(x = term, y = estimate,
ymin = conf.low, ymax = conf.high,
shape = group, colour = group)) +
geom_hline(yintercept = 1, linetype = 2) +
geom_pointrange(position = position_dodge(width = 0.45)) +
coord_flip() +
labs(x = NULL, y = "Odds ratio (95% CI)",
title = "Main vs AI models",
subtitle = "polr() results for lninc and lnincfed across five specifications") +
facet_wrap(~ model_num, ncol = 1) +
theme_minimal(base_size = 12) +
theme(legend.position = "top")
